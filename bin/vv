#!/usr/bin/env bash
# vv — send clipboard content (file path or screenshot) to agent VM
set -euo pipefail

VM_USER="ubuntu"
VM_HOST="agent.ql"
VM_DIR="/tmp/vv"

# Try screenshot first
img="/tmp/screenshot-$(date +%s).png"
if pngpaste "$img" 2>/dev/null; then
  # Reject macOS generic file-type icons (1024x1024, ~68KB)
  dims=$(sips -g pixelWidth -g pixelHeight "$img" 2>/dev/null | awk '/pixel/{print $2}')
  w=$(echo "$dims" | head -1)
  h=$(echo "$dims" | tail -1)
  if [[ "$w" == "1024" && "$h" == "1024" ]]; then
    rm "$img"
    echo "Error: clipboard has a file icon, not a screenshot. Use Cmd+Shift+Ctrl+4 to capture." >&2
    exit 1
  fi

  remote_path="$VM_DIR/$(basename "$img")"
  ssh "$VM_USER@$VM_HOST" "mkdir -p $VM_DIR"
  scp -q "$img" "$VM_USER@$VM_HOST:$remote_path"
  rm "$img"
  echo "$remote_path"
  exit 0
fi

# Otherwise treat clipboard as a file path
clip="$(pbpaste)"
clip="${clip%$'\n'}"  # strip trailing newline

if [[ -z "$clip" ]]; then
  echo "Error: clipboard is empty" >&2
  exit 1
fi

if [[ ! -e "$clip" ]]; then
  echo "Error: not a valid file path: $clip" >&2
  exit 1
fi

remote_path="$VM_DIR/$(basename "$clip")"
ssh "$VM_USER@$VM_HOST" "mkdir -p $VM_DIR"
scp -q "$clip" "$VM_USER@$VM_HOST:$remote_path"
echo "$remote_path"
